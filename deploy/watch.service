[Unit]
Description=watch — movies for the TV and the browser
Documentation=file:/opt/watch/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as the person whose Movies folder this is, so the shelf is readable
# without any permission dance.
User=andrinoff
Group=andrinoff
WorkingDirectory=/opt/watch
# Binds to every interface on purpose: the TV needs plain HTTP on the LAN,
# and Caddy fronts 127.0.0.1:8092 for the browser.
ExecStart=/opt/watch/watch -addr 0.0.0.0:8092 -dir /home/andrinoff/Movies -data /var/lib/watch
Restart=always
RestartSec=3

# Hardening that keeps the shelf readable and SSDP speakable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/watch
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
